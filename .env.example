# ==============================================================
# THREADLINE FASHION SOURCING ASSISTANT - CONFIGURATION
# ==============================================================

# OPTION 1: OpenRouter API (Zero-Config, Pre-Seeded 1:1 with Gemini)
# Get your API key from https://openrouter.ai/keys
# Just set this single key! All models and fallbacks are pre-seeded 1:1 with Google AI Studio:
# - Primary: google/gemini-2.5-flash <-> gemini-2.5-flash
# - Fallback 1: google/gemini-2.5-pro <-> gemini-2.5-pro
# - Fallback 2: google/gemini-2.0-flash-001 <-> gemini-3.8-flash
# - Fallback 3: google/gemini-flash-1.5 <-> gemini-3.1-flash-lite
OPENROUTER_API_KEY=""
# Optional overrides (leave blank to use the pre-seeded 1:1 chain above):
# OPENROUTER_MODEL="google/gemini-2.5-flash"
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# OPTION 2: Native Google AI Studio Gemini API Key
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Application Host URL (used for CORS, headers, and OpenRouter rankings)
APP_URL="https://threadline.vercel.app"
